<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests the parts of NuclearTrollstav that need no game - the alert scheduler (chaining, gap, cooldowns), the
    range test, the volume clamp and the send throttle (src\AlertRules.cs), and the plugin's own log file (which lines
    go in, their format, appending, rotation and the line limit: src\LogFile.cs) - compiled from the real source files.
    Run with "dotnet run" from this folder.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>NuclearTrollstav.Tests</AssemblyName>
    <RootNamespace>NuclearTrollstav</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultItems>false</EnableDefaultItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\build\tests\</OutputPath>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TestMain.cs" />
    <Compile Include="..\src\AlertRules.cs" />
    <Compile Include="LogTests.cs" />
    <Compile Include="..\src\LogFile.cs" />
  </ItemGroup>

</Project>
